# App registrado em developers.mercadolivre.com.br ("Criar aplicação")
ML_CLIENT_ID=1234567890123456
ML_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Precisa ser idêntica à Redirect URI cadastrada no app
ML_REDIRECT_URI=https://example.com/callback

# Bot do Telegram: notifica quando um anúncio é criado (opcional — sem essas
# duas variáveis a notificação é simplesmente pulada) e, se `anunciar-bot`
# estiver rodando, também recebe fotos por /start-photos + /finish-photos
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# API self-hosted do withoutbg (remoção de fundo) — só usada por anunciar-bot
WITHOUTBG_URL=http://SEU-HOST:8000
